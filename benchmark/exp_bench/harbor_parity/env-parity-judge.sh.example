# Judge settings for Harbor parity runs.
# Copy to evaluation/setup/env-parity-judge.sh (gitignored) and fill in.
# MODEL is the judge model name sent to the endpoint, without a provider prefix; it must
# equal EXP_BENCH_JUDGE_MODEL on the Harbor side (upstream judge: o3-mini). It also
# selects the context length used to chunk large diffs (helper/utils.py), as in Harbor.
export MODEL="o3-mini"
export OPENAI_API_KEY="<api-key>"
export OPENAI_BASE_URL="https://app.ppapi.ai/v1"
