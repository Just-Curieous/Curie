# Base image with Python and Conda
# BASE_IMAGE: upstream uses :latest. For reproducible parity runs pass a fixed tag,
# e.g. --build-arg BASE_IMAGE=continuumio/miniconda3:25.1.1-2 (see harbor_parity/README.md).
ARG BASE_IMAGE=continuumio/miniconda3:latest
FROM ${BASE_IMAGE}

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Update package index and install dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    build-essential \
    vim \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x and npm
# NPM_VERSION: upstream installs npm@latest, which no longer supports Node 20 (npm 12
# needs Node >= 22). Parity builds pin a version from early 2025 (see harbor_parity/README.md).
ARG NPM_VERSION=latest
RUN curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y nodejs && \
    npm install -g npm@${NPM_VERSION}


# Verify Node.js version
RUN node --version


# Copy the environment specification
COPY environment.yml .

# Install micromamba
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ENV PATH=$MAMBA_ROOT_PREFIX/bin:$PATH

RUN arch=$(uname -m) && \
    mkdir -p /tmp/mamba && cd /tmp/mamba && \
    if [ "$arch" = "x86_64" ]; then \
      echo "Downloading micromamba for x86_64..." && \
      wget -qO- https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba; \
    elif [ "$arch" = "aarch64" ]; then \
      echo "Downloading micromamba for aarch64..." && \
      wget -qO- https://micro.mamba.pm/api/micromamba/linux-aarch64/latest | tar -xvj bin/micromamba; \
    elif [ "$arch" = "ppc64le" ]; then \
      echo "Downloading micromamba for ppc64le..." && \
      wget -qO- https://micro.mamba.pm/api/micromamba/linux-ppc64le/latest | tar -xvj bin/micromamba; \
    else \
      echo "Unsupported architecture: $arch" && exit 1; \
    fi && \
    mv /tmp/mamba/bin/micromamba /usr/local/bin/ && \
    rm -rf /tmp/mamba

# Create base environment with micromamba
RUN micromamba create -n exp-bench -f environment.yml && \
    micromamba clean --all --yes

ENV MAMBA_DEFAULT_ENV=exp-bench
ENV PATH=/opt/micromamba/envs/exp-bench/bin:$PATH

# CONDA_NODEJS_SPEC / CONDA_POETRY_SPEC: upstream takes the latest versions; parity builds
# pin versions contemporary with OPENHANDS_REF so `make build` keeps working.
ARG CONDA_NODEJS_SPEC="nodejs>=20"
ARG CONDA_POETRY_SPEC=poetry
RUN micromamba install -y -c conda-forge python=3.12 "${CONDA_NODEJS_SPEC}" "${CONDA_POETRY_SPEC}" && micromamba clean --all -y

# Create the keyrings directory and add Docker's official GPG key
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg

# Set up the Docker repository
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" \
    | tee /etc/apt/sources.list.d/docker.list > /dev/null

# Update package index again and install Docker Engine
RUN apt-get update && apt-get install -y \
    docker-ce \
    docker-ce-cli \
    containerd.io \
    docker-compose-plugin 

RUN mkdir -p /helper_openhands
# Clone OpenHands repository.
# OPENHANDS_REF: any commit or tag; the default is the commit upstream EXP-Bench pins
# (release 0.27.0 plus 7 later main commits). Change it only together with the OpenHands
# version used on the Harbor side of a parity comparison.
ARG OPENHANDS_REPO=https://github.com/All-Hands-AI/OpenHands.git
ARG OPENHANDS_REF=02bc7de36dda10d890d39ac05fee16a0d55193f6
RUN mkdir -p /helper_openhands/OpenHands && cd /helper_openhands/OpenHands && \
    git init -q . && git remote add origin ${OPENHANDS_REPO} && \
    git fetch -q --depth 1 origin ${OPENHANDS_REF} && git checkout -q FETCH_HEAD && \
    echo "OpenHands ${OPENHANDS_REF} -> $(git rev-parse HEAD)" | tee /helper_openhands/OPENHANDS_COMMIT
RUN cd /helper_openhands/OpenHands && make build

# # Install additional Python packages using micromamba
# RUN micromamba run -n exp-bench pip install langchain-core==0.3.29 langgraph==0.2.52

RUN echo "source setup/env-openhands.sh" >> ~/.bashrc

# Update the Azure configuration
# AZURE_ORG_PATCH: these line-number patches add the upstream authors' Azure organization
# to the litellm version locked at the default OPENHANDS_REF. They only affect Azure
# calls; set AZURE_ORG_PATCH=0 for OpenAI/Anthropic-compatible endpoints or other refs.
ARG AZURE_ORG_PATCH=1
RUN if [ "${AZURE_ORG_PATCH}" = "1" ]; then \
    sed -i '474i \                    "organization": "014482",' /root/.cache/pypoetry/virtualenvs/openhands-ai-*-py3.12/lib/python3.12/site-packages/litellm/llms/azure/azure.py && \
    sed -i '49d' /root/.cache/pypoetry/virtualenvs/openhands-ai-*-py3.12/lib/python3.12/site-packages/litellm/llms/azure/chat/o_series_handler.py && \
    sed -i '49i \                    organization="014482",' /root/.cache/pypoetry/virtualenvs/openhands-ai-*-py3.12/lib/python3.12/site-packages/litellm/llms/azure/chat/o_series_handler.py ; \
    fi
# RUN sed -i '474i \\    \"organization\": \"014482\",' /opt/micromamba/envs/exp-bench/lib/python3.12/site-packages/litellm/llms/azure/azure.py 

# To support docker initialization from EXP-Bench
# Same two inserts as upstream's `sed -i '238i ...'` (docker.sock mount in the sandbox) and
# `sed -i '36i ...'` (sandbox uid 0 -> 123), anchored on code instead of line numbers so
# OPENHANDS_REF can change; byte-identical to the sed commands at the default ref.
ARG OPENHANDS_DOCKER_SOCK_PATCH=1
COPY harbor_parity/patch_openhands.py /tmp/patch_openhands.py
RUN python3 /tmp/patch_openhands.py /helper_openhands/OpenHands $([ "${OPENHANDS_DOCKER_SOCK_PATCH}" = "1" ] || echo --no-docker-sock)

# Create necessary directories
RUN mkdir -p /workspace

# Set PATH to activate the Conda environment automatically in the container
ENV PATH=/opt/micromamba/envs/exp-bench/bin:$PATH

# Ensure bash is the default shell
SHELL ["/bin/bash", "-c"]

# Keep container running
CMD ["tail", "-f", "/dev/null"]